# notebooks/split_quantlet_seminars.py; local copies stay here because the instructor PDFs and builders use them.
# =====================================================================================================
instructor/
*_solutions.*
*_solutions (*).*

# notebooks are published in English only
notebooks/RO/

# seminar code and results (solutions of Proposed exercises), chapter level of Quantlets/Ch_NN
/Quantlets/Ch_*/seminar[0-9]*.py
/Quantlets/Ch_*/seminar[0-9]*_charts.py
/Quantlets/Ch_*/sem[0-9]*_results.json
/Quantlets/Ch_*/seminar[0-9]*_results.json
/Quantlets/Ch_*/ch[0-9]*_sem_*.csv
/Quantlets/Ch_*/ch[0-9]*_sem_*.json
/Quantlets/Ch_*/ch[0-9]*_sem_*.npz
/Quantlets/Ch_*/ch[0-9]*_seminar_*.json
# result files written into seminar Quantlet folders
Quantlets/Ch_*/TSA_ch*_sem*/sem*_results.json
Quantlets/Ch_*/TSA_ch*_sem*/seminar*_results.json
Quantlets/Ch_*/TSA_ch*_sem*/ch*_sem_*.csv

